---
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Rockfall Lekgowe Group | Efficient quality, affordable legal services",
  description = "Rockfall Lekgowe Group is a law firm offering efficient, quality and affordable legal services in property, litigation and commercial matters.",
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14295C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
